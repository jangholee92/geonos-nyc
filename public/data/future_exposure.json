{
  "source": {
    "id": "nyc-future-flood-2050s-npcc2013",
    "title": "Future Floodplain 2050s — historical NPCC 2013 high-estimate scenario",
    "publisher": "NYC Mayor’s Office of Climate and Environmental Justice / NPCC / CUNY Institute for Sustainable Cities",
    "dataset_id": "27ya-gqtm",
    "url": "https://data.cityofnewyork.us/Environment/Future-Floodplain-2050s/27ya-gqtm",
    "api_url": "https://data.cityofnewyork.us/resource/27ya-gqtm.geojson?%24select=the_geom&%24limit=20000",
    "report_url": "https://www.nyc.gov/html/planyc2030/downloads/pdf/npcc_climate_risk_information_2013_report.pdf",
    "source_data_updated_at": "2013-07-23",
    "source_metadata_updated_at": "2026-04-21",
    "retrieved_at": "2026-10-27",
    "scenario": "NPCC 2013 90th-percentile high estimate; +31 inches sea-level rise; coastal 1% annual-chance event",
    "period": "2050s",
    "nominal_year": 2050,
    "sea_level_rise_inches": 31,
    "annual_chance_percent": 1,
    "spatial_resolution": "Source mapping used 2010 NYC LiDAR interpolated to a 1-foot DEM (NAVD88). Output is a vector flood-zone extent, not a 1-foot-accurate prediction. This join uses a PLUTO approximate tax-lot point, not parcel area or building footprint.",
    "method": "Point-in-polygon inclusion (boundary included), EPSG:4326. Value 1 means the approximate lot point intersects one or more polygons; 0 means it does not intersect this scenario layer. This is not a parcel-wide or building-wide intersection test.",
    "metric": "projected_flood_zone",
    "unit": "binary membership (0 outside / 1 inside this scenario polygon)",
    "depth_unit": null,
    "depth_available": false,
    "limitations": [
      "Historical 2013 planning scenario, not the latest available projection or an exact forecast for calendar year 2050.",
      "The NPCC 2013 report explicitly advises against using these illustrative maps to judge site-specific risks, insurance rates or property values; use this layer as scenario context only, outside suitability scoring.",
      "0 does not mean no future flood risk or no lot/building exposure: the point can be outside while another part of the lot is inside.",
      "A 1 does not provide flood depth, floor inundation, damage, insurance requirements or a regulatory determination.",
      "Model and data uncertainties mean mapped boundaries must not be read as the actual future inundation extent.",
      "This layer concerns coastal flooding with sea-level rise; rainfall, sewer, groundwater and future protective works are not inferred.",
      "Do not compare a future point-membership result with a current any-portion-of-lot PLUTO flag as a quantified change in risk; the spatial methods differ."
    ],
    "period_start_year": 2050,
    "period_end_year": 2059,
    "sea_level_baseline_period": "2000-2004",
    "source_mapping_method": "NPCC 2013 added its high-estimate sea-level increment to FEMA June 2013 Preliminary Work Map base flood elevations, then extended the extent landward to corresponding terrain elevations."
  },
